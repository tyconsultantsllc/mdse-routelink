<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Without this, a real push notification falls back to the full
             app launcher icon for its status-bar glyph - and Android forces
             that to render as a plain white blob, since a status-bar icon
             is required to be a simple white silhouette on transparent, not
             a full-color image. drawable-*/ic_stat_notification.png is a
             simplified monochrome mark drawn for exactly this (a bottle
             with a cross, echoing the real logo's own emblem, simplified
             enough to read clearly at 24dp); default_notification_color
             tints it navy to match the brand instead of leaving it plain
             white. Both are read directly by the Firebase Messaging SDK,
             independent of anything in capacitor.config.ts. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificationIconColor" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The web app already uses these through standard browser APIs -
         driver location tracking (navigator.geolocation) and delivery
         photo/signature capture (file input with the camera). Declaring
         them here is what lets the WebView actually grant those requests
         instead of silently failing; Android still shows its normal
         runtime permission prompt the first time each one is used. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Required on Android 13+ to show push notifications at all - the
         app must declare this, then ask for it at runtime (handled by
         @capacitor/push-notifications' requestPermissions(), called from
         lib/use-push-registration.ts). Silently ignored on older Android
         versions, which never required this permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the app prompt for a fingerprint/face scan (the "Unlock with
         fingerprint" setting, backed by @aparajita/capacitor-biometric-auth).
         The plugin's own manifest normally brings this in via Gradle's
         manifest merger, but it's declared here too so it's not silently
         missing if that merge ever doesn't happen. Harmless if redundant. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
