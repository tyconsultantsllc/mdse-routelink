<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Apps targeting SDK 35 (Android 15) draw edge-to-edge by default -
             the WebView's content extends behind the status bar/notification
             shade unless the page itself adds safe-area padding, which is
             what made the very top of the app hard to tap (touches there
             were landing on the status bar's pull-down gesture area instead
             of the page). This theme attribute is Android's own documented
             opt-out for exactly this situation - it makes the system
             reserve space for the status/navigation bars again, the same
             way it always did before Android 15. It's silently ignored on
             versions before Android 15, so this is safe on any supported
             device. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>

        <!-- Android 12+'s real launch splash (the "Theme.SplashScreen" this
             style extends from). On these OS versions, `android:background`
             above is ignored in favor of these `windowSplashScreen*`
             attributes - and this is a hard platform restriction, not
             something more config can work around: the OS will only ever
             show a small icon centered on a solid color here, never a full
             custom image. So instead of fighting that, this reuses the
             app's own adaptive-icon foreground (no new asset needed) on a
             background matching its disc color, so at least this brief,
             unavoidable first frame looks intentional and on-brand. The
             real "big logo" splash comes immediately after, from the web
             app itself (see components/app-loading-overlay.tsx) - that's
             just page content, so it isn't restricted this way. -->
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#B8D0E0</item>
        <!-- Required by installSplashScreen(): the theme the app switches to
             once the native splash is dismissed. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>